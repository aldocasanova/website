---
import Layout from '../layouts/Layout.astro';
---
<Layout page={null} title="404">
  <section class="lost-page">
    <p class="terminal-label">[exit: 404]</p>
    <h1>404 — path not found</h1>
    <pre class="lost-character" aria-hidden="true">{'   /\\_/\\\n  ( o.o )  ?\n   > ^ <\n  /     \\'} </pre>
    <p>Nothing at this address.<br />Let's find our way back.</p>
    <a href="/">cd ~/home</a>
  </section>
</Layout>
