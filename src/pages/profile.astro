---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { profile, projects } from '../config';
import ProjectImage from '../components/ProjectImage.astro';
import PageEnd from '../components/PageEnd.astro';
import { getPosts, postUrl } from '../lib/posts';
const latest = (await getPosts())[0];
const portraits = import.meta.glob<{ default: ImageMetadata }>('../../public/img/*.{jpg,jpeg,JPG,png,webp}', { eager: true });
const avatar = portraits[`../../public${profile.image}`]?.default;
---
<Layout page="profile" title="Profile">
  <div class="profile-intro">
    <div>
      <h1>{profile.name}</h1>
      <p class="profile-role">{profile.role}</p>
      <p class="location">{profile.location}</p>
    </div>
    {avatar && <a class="photo-link profile-photo-link" href={profile.image} data-photo data-astro-reload aria-label="Enlarge Aldo Casanova’s illustrated avatar"><Image class="profile-photo" src={avatar} alt="Aldo Casanova’s illustrated avatar" width={128} height={128} widths={[128, 256]} sizes="128px" format="webp" /></a>}
  </div>
  <section class="profile-section" aria-labelledby="about">
    <h2 id="about">About</h2>
    <p>I am a Computer Science Engineering student based in Sucre, Bolivia. My work spans applied machine learning and web development, with projects in multi-agent traffic control and e-commerce.</p>
    <p>I am interested in how software can address practical problems, from evaluating decisions in a simulated city to building tools for everyday business operations.</p>
  </section>
  <section class="profile-section" aria-labelledby="work">
    <h2 id="work">Selected work</h2>
    <div class="project-list">
      {projects.map((project, index) => (
        <article class="project" aria-labelledby={project.id}>
          <p class="project-category"><span aria-hidden="true">{String(index + 1).padStart(2, '0')} / </span>{project.category}</p>
          <h3 id={project.id}><a href={`/projects/${project.id}/`}>{project.name}</a></h3>
          <p>{project.summary}</p>
          <ProjectImage name={project.name} image={project.image} />
          <a class="case-link" href={`/projects/${project.id}/`}>Read case study <span aria-hidden="true">↗</span><span class="sr-only">: {project.name}</span></a>
          <ul class="project-technologies" aria-label={`${project.name} technologies`}>
            {project.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
          <details class="project-disclosure">
            <summary><span class="disclosure-marker" aria-hidden="true"></span>Project details<span class="sr-only">: {project.name}</span></summary>
            <div class="project-details-content">
              <p>{project.description}</p>
              <p>{project.details}</p>
              {project.url && <a class="inverse-link" href={project.url}>View project</a>}
            </div>
          </details>
        </article>
      ))}
    </div>
  </section>
  <section class="profile-section" aria-labelledby="technical-focus">
    <h2 id="technical-focus">Technical focus</h2>
    <dl class="technical-focus">
      <div><dt>Machine learning</dt><dd>Python, PyTorch, reinforcement learning, and simulation with SUMO.</dd></div>
      <div><dt>Web development</dt><dd>TypeScript, Vue, Nuxt, Express, and static sites with Astro.</dd></div>
      <div><dt>Data &amp; tools</dt><dd>PostgreSQL, Prisma, Git, and Linux.</dd></div>
    </dl>
  </section>
  <section class="profile-section" aria-labelledby="elsewhere">
    <h2 id="elsewhere">Elsewhere</h2>
    <ul class="social-links">
      {(['github', 'linkedin'] as const).map((key) => (
        <li>
          {profile[key] ? <a class="inverse-link" href={profile[key]}>{key === 'github' ? 'GitHub' : 'LinkedIn'}</a>
            : <><span>{key === 'github' ? 'GitHub' : 'LinkedIn'}</span><span class="pending-link">not added yet</span></>}
        </li>
      ))}
    </ul>
  </section>
  <PageEnd back={{ href: '/', label: '← Home' }} links={[{ href: latest ? postUrl(latest.id) : '/blog/', label: 'From the notebook', title: latest?.data.title ?? 'Explore the notes' }]} />
</Layout>
