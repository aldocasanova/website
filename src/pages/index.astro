---
import { Image } from 'astro:assets';
import city from '../../public/img/homeimage.JPG';
import Layout from '../layouts/Layout.astro';
---
<Layout page="home" description="Aldo Casanova. Sucre, Bolivia.">
  <div class="home-content">
    <h1 class="sr-only">Aldo Casanova — Home</h1>
    <a class="photo-link city-photo-link" href="/img/homeimage.JPG" data-photo data-astro-reload aria-label="Enlarge the photograph of Sucre">
      <Image class="city-photo" src={city} alt="The streets and church towers of Sucre at dusk." width={1120} widths={[400, 640, 880, 1120]} sizes="(max-width: 600px) calc(100vw - 40px), 560px" format="webp" quality={85} loading="eager" fetchpriority="high" />
    </a>
    <p class="city-clock">
      <span>Time in Sucre</span>
      <time id="sucre-time" aria-label="Current time in Sucre">--:--:--</time>
      <span>BOT</span>
    </p>
    <noscript><p class="no-script-clock">Sucre is UTC−04:00. Enable JavaScript for the live clock.</p></noscript>
  </div>
</Layout>
