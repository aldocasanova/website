---
import Navigation from '../components/Navigation.astro';
import AsciiVisitors from '../components/AsciiVisitors.astro';
import RouteTransition from '../components/RouteTransition.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { siteOrigin, isPreview } from '../../config/site.mjs';

interface Props {
  title?: string;
  page: 'home' | 'profile' | 'blog' | null;
  description?: string;
}
const { title, page, description = 'Aldo Casanova. Computer Science Engineering student. Notes and selected work.' } = Astro.props;
const pageTitle = title ? `${title} / aldocasanova` : 'aldocasanova';
const canonical = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : undefined;
const shareImage = siteOrigin ? new URL('/share.png', siteOrigin).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{pageTitle}</title>
    <meta name="author" content="Aldo Casanova" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {(page === null || isPreview) && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <><meta property="og:image" content={shareImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Aldo Casanova — selected work and notes, in a monochrome terminal composition." /></>}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={[page === 'home' ? 'home-page' : 'inner-page']}>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header"><Navigation active={page} /></header>
      <main id="content" tabindex="-1" data-ascii-avoid><slot /></main>
    </div>
    <AsciiVisitors />
    <RouteTransition />
    <PhotoViewer />
    <CommandPalette />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
