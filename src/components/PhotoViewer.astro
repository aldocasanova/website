<dialog id="photo-viewer" aria-labelledby="photo-viewer-title">
  <div class="viewer-toolbar">
    <h2 id="photo-viewer-title">Image preview</h2>
    <form method="dialog"><button type="submit" aria-label="Close image viewer" title="Close (Escape)" autofocus>[×]</button></form>
  </div>
  <figure>
    <img id="viewer-image" alt="" />
    <figcaption id="viewer-caption"></figcaption>
  </figure>
</dialog>
