---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props {
  name: string;
  image: { src: string; alt: string; caption: string };
}
const { name, image } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../public/img/**/*.{jpg,jpeg,JPG,JPEG,png,webp,avif}', { eager: true });
const source = image.src ? images[`../../public${image.src}`]?.default : undefined;
if (image.src && !source) throw new Error(`Project image not found in public/img: ${image.src}`);
if (source && !image.alt.trim()) throw new Error(`Add an image description for ${name}.`);
---
<figure class="project-media">
  {source ? <>
    <a class="photo-link project-photo-link" href={image.src} data-photo data-astro-reload aria-label={`Enlarge image: ${image.alt}`}>
      <Image src={source} alt={image.alt} width={840} widths={[360, 660, 840, 1320]} sizes="(max-width: 708px) calc(100vw - 48px), 660px" format="webp" loading="lazy" />
    </a>
    {image.caption && <figcaption>{image.caption}</figcaption>}
  </> : <div class="project-image-placeholder" role="img" aria-label={`Image for ${name} forthcoming`}><span>Image forthcoming</span></div>}
</figure>
